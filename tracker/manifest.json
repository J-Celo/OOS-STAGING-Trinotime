{
  "manifest_version": 3,
  "name": "TrinoTime QC Tracker — STAGING QA",
  "version": "2.2.63",
  "description": "STAGING QA ONLY: isolated test backend; Coverage/Confirmation capture, activity coordination, safe sync and lightweight scanning.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://labeling-tools.augmoto.com/*",
    "https://oostrinotime-staging-qa.trinoadmin.workers.dev/*"
  ],
  "action": {
    "default_title": "TrinoTime QC Tracker — STAGING QA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "trinotime-icon-16.png",
      "32": "trinotime-icon-32.png",
      "48": "trinotime-icon-48.png",
      "128": "trinotime-icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://labeling-tools.augmoto.com/*"
      ],
      "js": [
        "tracker-availability.js",
        "search-presence.js",
        "activity-integrity.js",
        "workflow-coordinator.js",
        "job-mode.js",
        "task-efficiency.js",
        "hud-appearance.js",
        "store-intelligence.js",
        "coverage.js",
        "confirmation.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://oostrinotime-staging-qa.trinoadmin.workers.dev/*"
      ],
      "js": [
        "trinotime-session-relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "trinotime-icon-16.png",
    "32": "trinotime-icon-32.png",
    "48": "trinotime-icon-48.png",
    "128": "trinotime-icon-128.png"
  },
  "version_name": "2.2.63 · STAGING QA · production v2.3.20 parity"
}
